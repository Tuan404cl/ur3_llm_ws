<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Ánh sáng trực tiếp (Không tải qua mạng) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Mặt đất trực tiếp (Không tải qua mạng) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Bàn thao tác -->
    <model name="table">
      <static>true</static>
      <pose>0.4 0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.8 1.0 0.8</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.8 1.0 0.8</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Camera nhận diện (Overhead) -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.4 0 2.0 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.05 0.1 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
        <sensor name="camera1" type="camera">
          <update_rate>30.0</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>800</width><height>800</height><format>R8G8B8</format></image>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros><remapping>~/image_raw:=/camera/image_raw</remapping></ros>
            <camera_name>camera</camera_name>
            <frame_name>camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>